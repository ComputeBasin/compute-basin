PORT=8787
CORS_ORIGIN=http://localhost:5173

# Wallet admin autorizzato a creare pool e gestire fase operativa
ADMIN_WALLET=

# Legacy override: true forces mock mode regardless of selected network.
# Preferred approach: keep false and select IOTA_NETWORK=mock from admin dashboard.
MOCK_IOTA=false

# mock|localnet|testnet|mainnet
IOTA_NETWORK=testnet
# When IOTA_NETWORK=mock, this base profile is used for optional package/rpc defaults.
IOTA_MOCK_BASE_NETWORK=testnet
IOTA_FULLNODE_URL=
IOTA_PACKAGE_ID=
# Optional override for escrow module package id (defaults to IOTA_PACKAGE_ID)
IOTA_ESCROW_PACKAGE_ID=
IOTA_SIGNER_SECRET_KEY=
IOTA_GAS_BUDGET=100000000
IOTA_NOTARIZATION_PROVIDER=passport
USE_IOTA_ESCROW=true

# Optional per-network overrides (used when admin switches active network from dashboard)
IOTA_LOCALNET_FULLNODE_URL=http://127.0.0.1:9000
IOTA_LOCALNET_PACKAGE_ID=
IOTA_LOCALNET_ESCROW_PACKAGE_ID=
IOTA_LOCALNET_SIGNER_SECRET_KEY=

IOTA_TESTNET_FULLNODE_URL=
IOTA_TESTNET_PACKAGE_ID=
IOTA_TESTNET_ESCROW_PACKAGE_ID=
IOTA_TESTNET_SIGNER_SECRET_KEY=

IOTA_MAINNET_FULLNODE_URL=
IOTA_MAINNET_PACKAGE_ID=
IOTA_MAINNET_ESCROW_PACKAGE_ID=
IOTA_MAINNET_SIGNER_SECRET_KEY=

# Contribution payment policy for legacy pool funding route
# false: off-chain demo ledger
# true: escrow funding flow (live = wallet-signed tx digest; mock = simulated digest)
# note: with on-chain mode, USE_IOTA_ESCROW=true is mandatory
REQUIRE_ONCHAIN_CONTRIBUTION=true
CONTRIBUTION_PRICE_NANOS=1000000
# If empty, defaults to ADMIN_WALLET
# Treasury destination for admin escrow withdraw
CONTRIBUTION_RECIPIENT_WALLET=
