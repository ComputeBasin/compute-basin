PORT=8787
CORS_ORIGIN=http://localhost:5173

# Wallet admin autorizzato a creare pool e gestire fase operativa
ADMIN_WALLET=

# true=mock, false=live IOTA tx
MOCK_IOTA=true

IOTA_NETWORK=testnet
IOTA_FULLNODE_URL=
IOTA_PACKAGE_ID=
IOTA_SIGNER_SECRET_KEY=
IOTA_GAS_BUDGET=100000000

# Contribution payment policy for legacy pool funding route
# false: off-chain demo ledger
# true: requires wallet-signed IOTA transfer tx digest in /api/pools/:poolId/contribute
# note: with on-chain mode, refunds also send IOTA from backend signer wallet
REQUIRE_ONCHAIN_CONTRIBUTION=false
CONTRIBUTION_PRICE_NANOS=1000000
# If empty, defaults to ADMIN_WALLET
# Use a dedicated treasury wallet (different from contributor wallet)
CONTRIBUTION_RECIPIENT_WALLET=
